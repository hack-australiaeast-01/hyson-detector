# Copy to .env (never commit .env). Values: Azure AI Foundry project home page.
AZURE_OPENAI_ENDPOINT=https://aoai-fraud-australiaeast-vnxcy.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
COPILOT_MAX_TOKENS=600

# Copilot tuning (all optional; defaults shown)
# max live LLM calls per hour, then cached / offline answers (0 = no cap; use 60 on a public demo)
COPILOT_HOURLY_CAP=0
# 1 = force the deterministic offline copilot (tests, no paid calls)
COPILOT_OFFLINE=0
COPILOT_TIMEOUT=60
# reasoning effort for gpt-5 models: copilot + Le Procès / Enquête approfondie
COPILOT_REASONING=low
DEEP_REASONING=minimal

# Microsoft Fabric (live data). Auth = your Azure CLI login (az login) or browser sign-in. No secret here.
DATA_SOURCE=auto
FABRIC_SQL_ENDPOINT=5zjlklotatcebnfgq5du6bvg2u-syvwzdkqpmnexb5r5d4hfebwcm.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=lh_fraud
FABRIC_WORKSPACE_ID=8d6c2b96-7b50-4b1a-87b1-e8f872903613
FABRIC_LAKEHOUSE_ID=d904beab-ede8-41da-ab4f-63a95e07a773
# optional: force an ODBC driver (default = newest "ODBC Driver 1x for SQL Server" installed)
ODBC_DRIVER=

# Power BI report embedded in the app (secure embed: viewer signs in, nothing public)
PBI_REPORT_ID=146f267f-bb36-4331-9897-a414d7bb2894
PBI_TENANT_ID=2db552ee-04d3-40c4-b4a6-87474f06a6d5
